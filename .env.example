# Public name rendered in the header.
VITE_SITE_NAME=Silverfort API

# Used for introspection and as the initial Apollo Sandbox endpoint.
VITE_GRAPHQL_ENDPOINT=https://api.cloudplatform.app.silverfort.com/graphql

# Use external when the API allows Apollo Studio but blocks this site's browser origin.
VITE_EXPLORER_MODE=external

# Optional: load SDL from a public URL instead of introspecting the endpoint.
# VITE_SCHEMA_URL=/schema.graphql

# Optional JSON object sent with introspection requests (do not put secrets in client builds).
# VITE_INTROSPECTION_HEADERS={"x-api-key":"public-key-only"}

# Allow visitors to switch schemas at runtime. Defaults to true.
VITE_ALLOW_CONFIGURATION=true
